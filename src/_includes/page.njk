---
layout: base.njk
---
<div class="page-title"><div class="wrap"><h1>{{ title }}</h1></div></div><main class="wrap content">{{ content | safe }}
{% if afficher_galerie %}<h2 class="sec">{{ galerie.titre }}</h2><p class="center">{{ galerie.intro }}</p><div class="gallery">{% for p in galerie.photos %}<a href="{{ p.image }}" target="_blank"><img loading="lazy" src="{{ p.image }}" alt="{{ p.legende }}" title="{{ p.legende }}"></a>{% endfor %}</div>{% endif %}
</main>
