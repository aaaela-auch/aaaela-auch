{%- macro href(l) -%}{% if l.startsWith("http") or l.startsWith("mailto:") %}{{ l }}{% else %}/{{ l }}{% endif %}{%- endmacro -%}
<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} – Amicale des Anciens Élèves du Lycée d'Auch</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="top"><div class="wrap top-in"><a href="/index.html" class="brand"><img src="{{ menu.logo }}" alt="Logo de l'Amicale"><span>{{ menu.nom_site }}<small>{{ menu.sous_titre | nl2br | safe }}</small></span></a><div class="actions">{% for b in menu.boutons %}<a class="btn" href="{{ href(b.lien) | trim }}">{{ b.libelle }}</a>{% endfor %}</div><button class="burger" aria-label="Menu" onclick="document.body.classList.toggle('open')">&#9776;</button></div>
<nav class="mainnav"><ul class="wrap">{% for m in menu.entrees %}<li><a href="{{ href(m.lien) | trim }}"{% if permalink == m.lien %} class=active{% endif %}>{{ m.libelle }}</a></li>{% endfor %}</ul></nav></header>
{{ content | safe }}
<footer><div class="wrap foot"><div><h4>Contact</h4><p>{{ site.footer_adresse | nl2br | safe }}</p><p>{% for e in site.emails %}<a href="mailto:{{ e }}">{{ e }}</a><br>{% endfor %}</p></div><div><h4>Liens</h4><p>{% for l in menu.liens_bas_de_page %}{% if not loop.first %}<br>{% endif %}<a href="{{ href(l.lien) | trim }}">{{ l.libelle }}</a>{% endfor %}</p></div><div class="flogo"><img src="{{ menu.logo }}" alt=""><span>{{ menu.logo_bas_de_page_texte }}</span></div></div>
<div class="bottom"><div class="wrap">{{ menu.copyright }}</div></div></footer></body></html>
