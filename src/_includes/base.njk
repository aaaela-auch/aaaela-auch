{%- set menu = [["index.html","Accueil"],["association.html","L'Association"],["publications.html","Publications"],["presidents.html","Anciens Présidents"],["ca.html","CA"],["statuts.html","Les Statuts"],["photos.html","Photos"],["evenements.html","Evènements"],["actualites.html","Actualités"],["adhesion.html","CONTACTEZ-NOUS"]] -%}
<!DOCTYPE html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }} – Amicale des Anciens Élèves du Lycée d'Auch</title><link rel="stylesheet" href="/css/style.css"></head><body>
<header class="top"><div class="wrap top-in"><a href="/index.html" class="brand"><img src="/img/logoaaaela.jpg" alt="Logo de l'Amicale"><span>AAAELA<small>Amicale des Anciens Élèves<br>du Lycée ou du Collège Salinis d'Auch</small></span></a><div class="actions"><a class="btn" href="/publications.html">Publications</a><a class="btn" href="/adhesion.html">CONTACTEZ-NOUS</a></div><button class="burger" aria-label="Menu" onclick="document.body.classList.toggle('open')">&#9776;</button></div>
<nav class="mainnav"><ul class="wrap">{% for m in menu %}<li><a href="/{{ m[0] }}"{% if permalink == m[0] %} class=active{% endif %}>{{ m[1] }}</a></li>{% endfor %}</ul></nav></header>
{{ content | safe }}
<footer><div class="wrap foot"><div><h4>Contact</h4><p>{{ site.footer_adresse | nl2br | safe }}</p><p>{% for e in site.emails %}<a href="mailto:{{ e }}">{{ e }}</a><br>{% endfor %}</p></div><div><h4>Liens</h4><p><a href="/photos.html">Photos</a><br><a href="/statuts.html">Les Statuts</a><br><a href="/evenements.html">Evènements</a></p></div><div class="flogo"><img src="/img/logoaaaela.jpg" alt=""><span>Depuis 1893</span></div></div>
<div class="bottom"><div class="wrap">© 2026 · Amicale des Anciens Élèves du Lycée d'Auch</div></div></footer></body></html>
